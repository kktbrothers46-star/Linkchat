# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ==============================================================================
# CLIENT-SIDE SUPABASE CONFIGURATION (Vercel & Median APK)
# ==============================================================================
# These two variables are the ONLY required Supabase variables for Vercel and the
# Median Android APK.
#
# - VITE_SUPABASE_URL: Your Supabase Project URL (Dashboard -> Project Settings -> API)
# - VITE_SUPABASE_ANON_KEY: Your Supabase 'anon' / 'public' key (safe for browser & WebView)
#
# DO NOT configure any service_role or admin secret keys.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

